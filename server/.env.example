# ---------------------------------------------------------------------------
# ReliefGov server configuration  (copy to server/.env and fill in values)
# NEVER commit real .env files or expose service-role keys to the client.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development
# Web origin of the client. Used for CORS and as the redirect target for
# Supabase password-recovery emails (client /reset-password page).
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (Data layer + Auth) ------------------------------------------
# Leave blank to run the server without a database connection.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Must NEVER be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session signing --------------------------------------------------------
# Used to sign API session tokens. Change this in any shared/deployed environment.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Vulnerability scoring (Random Forest) ---------------------------------
# Which implementation serves scores. The PRIMARY backend is the Python
# microservice in ml-service/ (scikit-learn RandomForestClassifier).
#   python      -> Python service only (default). If it is not running the
#                  scoring endpoints answer HTTP 503 - never a fabricated score.
#   auto        -> try Python, fall back to the bundled JS forest if the
#                  service is down (fallback is logged server-side).
#   javascript  -> bundled JS forest only (used by the offline test suite).
ML_BACKEND=python
ML_SERVICE_URL=http://127.0.0.1:8100
ML_SERVICE_TIMEOUT_MS=8000

# --- Synthetic demonstration data ------------------------------------------
# TRUE  -> the API serves clearly-labeled SYNTHETIC demo records for
#          Barangay Tambacan so the system can be demonstrated without Supabase.
# FALSE -> the API reports "database not configured" instead of demo records.
USE_SYNTHETIC_DEMO_DATA=true

# --- Development-only demo accounts (used only when Supabase is unconfigured)-
ENABLE_DEV_DEMO_LOGIN=true
DEV_DEMO_PASSWORD=ReliefGov!Demo123
